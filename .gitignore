# Default-deny root: only the reviewed public project is selectable by Git.
/*
!/.gitignore
!/.gitattributes
!/LICENSE
!/README.md
!/ART_EXPERIMENTS.md
!/RELEASE_NOTES.md
!/MOD_USAGE_GUIDE.md
!/TESTING_GUIDE.md
!/CONTRIBUTING.md
!/CHANGELOG.md
!/SECURITY.md
!/build.gradle.kts
!/settings.gradle.kts
!/gradle.properties
!/gradlew
!/gradlew.bat
!/build.ps1
!/build.sh
!/src/
!/gradle/
!/docs/
!/scripts/
!/.github/

/src/*
!/src/main/
!/src/test/
!/src/smoke/
!/src/showcase/
/gradle/*
!/gradle/wrapper/
/gradle/wrapper/*
!/gradle/wrapper/gradle-wrapper.properties
!/gradle/wrapper/gradle-wrapper.jar
/scripts/*
!/scripts/release*.py
/.github/*
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/build.yml

# Private/runtime/generated data is never selected, even under public directories.
**/.gradle/
**/.git/
**/.aws/
**/.codex/
**/.agents/
**/build/
**/bin/
**/logs/
**/saves/
**/world/
**/worlds/
**/evidence/
**/backups/
**/run*/
**/__pycache__/
**/.env*
**/*.log
**/*.log.gz
**/*.dat
**/*.dat_old
**/*.mca
**/*.lock
**/*.class
**/*.jar
!/gradle/wrapper/gradle-wrapper.jar
**/*.zip
**/*.7z
**/*.pem
**/*.key
**/launcher_accounts.json
**/launcher_profiles.json
**/options.txt
**/command_history.txt
